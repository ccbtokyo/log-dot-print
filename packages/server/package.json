{
  "name": "@log-dot-print/server",
  "version": "1.0.0",
  "description": "HTTP/WebSocket server for receiving logs from UE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "log-dot-print": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "node --import tsx --watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@log-dot-print/core": "*",
    "@log-dot-print/printer-core": "*",
    "@log-dot-print/printer-mock": "*",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
