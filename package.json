{
  "name": "log-dot-print",
  "version": "1.0.0",
  "description": "AI Log Printer System - Real-time printing of UE AI logs for art installations",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspace=@log-dot-print/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages/*/src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
