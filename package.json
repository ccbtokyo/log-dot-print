{
  "name": "log-dot-print",
  "version": "1.0.0",
  "private": true,
  "description": "AI Log Printer System for Art Installations",
  "bin": {
    "log-dot-print": "./dist/cli.js"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsgo && bun run build:ui",
    "build:ui": "bun scripts/build-ui.ts",
    "dev": "bun scripts/dev.ts",
    "dev:ui": "bun build src/ui/main.ts --outdir=dist/ui --format=esm --watch",
    "start": "node dist/cli.js",
    "test": "bun test",
    "verify": "bun run scripts/verify-endpoints.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "@printers/printers": "^1.1.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.4",
    "escpos-usb": "^3.0.0-alpha.4",
    "hono": "^4.11.4",
    "lit-html": "^3.2.0",
    "playwright": "^1.49.0",
    "serialport": "^12.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.9",
    "@types/serialport": "^8.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260129.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,html,css}": [
      "oxfmt --write"
    ]
  }
}
