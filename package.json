{
  "name": "log-dot-print",
  "version": "1.0.0",
  "type": "module",
  "description": "AI Log Printer System for Art Installations",
  "private": true,
  "main": "./dist/cli.js",
  "bin": {
    "log-dot-print": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsgo && bun run build:ui",
    "build:ui": "bun build src/ui/main.ts --outdir=dist/ui --format=esm && cp src/ui/index.html src/ui/styles/*.css dist/ui/",
    "dev": "bun run build:ui && (bun run dev:ui & bun --watch src/cli.ts)",
    "dev:ui": "bun build src/ui/main.ts --outdir=dist/ui --format=esm --watch",
    "start": "node dist/cli.js",
    "test": "bun test",
    "lint": "oxlint src",
    "format": "bunx oxfmt src"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.4",
    "escpos-usb": "^3.0.0-alpha.4",
    "hono": "^4.11.4",
    "lit-html": "^3.2.0",
    "serialport": "^12.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.9",
    "@types/serialport": "^8.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260128.1",
    "oxlint": "^1.39.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
