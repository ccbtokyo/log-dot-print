{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "Buffer": "readonly"
  }
}
